# ============================================================
# Variáveis de ambiente RapChef Landing Page
# Copie este arquivo para `.env.local` e preencha os valores.
# ============================================================

# Endpoint do Google Apps Script que recebe os leads (POST JSON).
# PLACEHOLDER: crie um Apps Script e cole a URL de publicação (Web App,
# acesso "Anyone" / "Anyone with the link"). Ex:
# VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec
VITE_APPS_SCRIPT_URL=

# Meta Pixel ID (ex: 1234567890123456). Deixe vazio para desativar o Pixel.
VITE_META_PIXEL_ID=
